		for (int j = i + 1; j < n; j++) {
			if (abs(A[j][i] > max)) {
				max = abs(A[j][i]);
				ind = j;
			}
		}
	
		if (max < EPS) {
			singular = true;
			cout << "singular matrix";
			return;
		}


		swap(A[i], A[ind]);
			
	
		for (int p = 1; p < n; p++) {
			for (int j = 1; j < n + 1; j++) {
				if (abs(A[p][j]) < EPS) {
					A[p][j] = 0;
				}
			}
		}

		double c;


		for (int p = i + 1; p < n; p++) {
			c = A[p][i] / A[i][i];
			for (int j = 0; j < n + 1; j++) {
				A[p][j] -= c * A[i][j];
			}
		}

		
